@page
@model IdentityService.Pages.Register.Index

@{
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";

    static string ButtonText(string? displayName)
        => string.Equals(displayName, "Google", StringComparison.OrdinalIgnoreCase) ? "Continue with Google"
         : string.Equals(displayName, "Facebook", StringComparison.OrdinalIgnoreCase) ? "Continue with Facebook"
         : $"Continue with {displayName ?? "provider"}";

    static string Icon(string? displayName)
    {
        if (string.Equals(displayName, "Google", StringComparison.OrdinalIgnoreCase))
        {
            return "<svg viewBox='0 0 48 48' width='18' height='18' aria-hidden='true'><path fill='#EA4335' d='M24 9.5c3.54 0 6.13 1.54 7.53 2.83l5.2-5.2C33.6 4.2 29.2 2 24 2 14.9 2 7.2 7.2 4.3 14.7l6.9 5.4C12.9 13.6 17.9 9.5 24 9.5Z'/><path fill='#4285F4' d='M46.1 24.5c0-1.6-.1-2.8-.4-4.1H24v7.8h12.6c-.3 2-1.8 5-5 7l7.6 5.9c4.4-4.1 6.9-10.1 6.9-17.6Z'/><path fill='#FBBC05' d='M11.2 28.2c-.5-1.4-.8-2.9-.8-4.4 0-1.5.3-3 .8-4.4l-6.9-5.4C3 16.7 2.2 20.1 2.2 23.8c0 3.7.8 7.1 2.3 10.2l6.7-5.8Z'/><path fill='#34A853' d='M24 46c6.5 0 11.9-2.1 15.8-5.8l-7.6-5.9c-2 1.4-4.7 2.4-8.2 2.4-6.1 0-11.1-4.1-12.9-9.8l-6.7 5.8C7.2 40.8 14.9 46 24 46Z'/></svg>";
        }

        if (string.Equals(displayName, "Facebook", StringComparison.OrdinalIgnoreCase))
        {
            return "<svg viewBox='0 0 24 24' width='18' height='18' aria-hidden='true'><path fill='#1877F2' d='M24 12.1C24 5.4 18.6 0 12 0S0 5.4 0 12.1C0 18.1 4.4 23.1 10.1 24v-8.5H7.1v-3.4h3V9.5c0-3 1.8-4.7 4.5-4.7 1.3 0 2.6.2 2.6.2v2.9h-1.5c-1.5 0-2 .9-2 1.9v2.3h3.4l-.5 3.4h-2.9V24C19.6 23.1 24 18.1 24 12.1Z'/></svg>";
        }

        return "<svg viewBox='0 0 24 24' width='18' height='18' aria-hidden='true'><path fill='currentColor' d='M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2Zm1 17.93V13h2.07l.33-2.4H13V8.77c0-.69.19-1.16 1.18-1.16h1.26V5.47A17.2 17.2 0 0 0 13.6 5.3c-1.78 0-3 1.09-3 3.09V10.6H8.5V13h2.1v6.93A8 8 0 1 1 13 19.93Z'/></svg>";
    }
}

<partial name="_ValidationSummary" />

<h1 class="auth-title">Sign Up</h1>

<form class="auth-form" asp-page="/Account/Register/Index">
    <input type="hidden" asp-for="Input.ReturnUrl" />

    <div class="form-group">
        <label asp-for="Input.Email" class="sr-only"></label>
        <input class="form-control" placeholder="Email address*" asp-for="Input.Email" autofocus>
    </div>

    <div class="form-group">
        <label asp-for="Input.Password" class="sr-only"></label>
        <input id="password" type="password" class="form-control" placeholder="Password*" asp-for="Input.Password" autocomplete="off">
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="showPassword" onchange="togglePassword()">
            <label class="form-check-label" for="showPassword">Show password</label>
        </div>
    </div>

    <button class="btn btn-primary auth-primary" name="Input.Button" value="register">Continue</button>

    <div class="mt-2" style="text-align:center;">
        <span style="color: var(--auth-muted);">Already have an account?</span>
        <a class="auth-link" asp-page="../Login/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Log in</a>
    </div>

    <div class="mt-2" style="text-align:center;">
        <button type="submit" class="btn btn-link p-0" name="Input.Button" value="cancel">Cancel</button>
    </div>
</form>

@if (Model.ExternalProviders.Any())
{
    <div class="auth-divider">OR</div>
    <div class="d-grid" style="gap: 10px;">
        @foreach (var provider in Model.ExternalProviders)
        {
            <a class="auth-provider"
               asp-page="/ExternalLogin/Challenge"
               asp-route-scheme="@provider.AuthenticationScheme"
               asp-route-returnUrl="@Model.Input.ReturnUrl">
                <span class="auth-provider__icon">@Html.Raw(Icon(provider.DisplayName))</span>
                <span>@ButtonText(provider.DisplayName)</span>
            </a>
        }
    </div>
}

@if (Model.RegisterSuccess)
{
    <div class="alert alert-success mt-3">
        <strong>Successfully registered!</strong> You can now login.
    </div>
}

<script>
    function togglePassword() {
        var password = document.getElementById('password');
        if (!password) return;
        password.type = password.type === 'password' ? 'text' : 'password';
    }
</script>